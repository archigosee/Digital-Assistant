# Set these in the Vercel dashboard (Project amharic-assistant-api > Settings > Environment Variables).
# Never commit real values.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: model override (default gemini-flash-latest)
GEMINI_MODEL=
# Optional: separate secret for signing app tokens (default: derived from GEMINI_API_KEY)
APP_TOKEN_SECRET=
